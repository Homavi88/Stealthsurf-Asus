#!/bin/sh
# StealthSurf Alfa — служба панели :8788
# Не трогает /jffs/addons/ssurf и /jffs/addons/stealthsurf.
export PATH="/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

ADDON_DIR="${ALFA_DIR:-/jffs/addons/alfa}"
# /tmp надёжнее /var/run на Merlin (tmpfs, но не чистится mid-session так агрессивно при замене jffs)
PID_FILE="${ALFA_PID_FILE:-/tmp/alfa-panel.pid}"
LOG_FILE="${ALFA_LOG_FILE:-/tmp/alfa-panel.log}"
PORT="${ALFA_PORT:-8788}"

die() {
  echo "alfa: $*" >&2
  exit 1
}

resolve_node() {
  if [ -n "${ALFA_NODE:-}" ] && [ -x "$ALFA_NODE" ]; then
    echo "$ALFA_NODE"
    return 0
  fi
  if [ -f "$ADDON_DIR/.node-bin" ]; then
    saved="$(cat "$ADDON_DIR/.node-bin" 2>/dev/null)"
    if [ -x "$saved" ]; then
      echo "$saved"
      return 0
    fi
  fi
  for c in /opt/bin/node /opt/bin/nodejs; do
    [ -x "$c" ] && echo "$c" && return 0
  done
  return 1
}

is_running() {
  [ -f "$PID_FILE" ] || return 1
  kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

# PID панели: pidfile + node run.mjs/server.mjs с меткой alfa / cwd аддона.
panel_pids() {
  pids=""
  if [ -f "$PID_FILE" ]; then
    p="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$p" ] && pids="$p"
  fi
  # совместимость со старым pidfile
  if [ -f /var/run/alfa.pid ]; then
    p="$(cat /var/run/alfa.pid 2>/dev/null)"
    [ -n "$p" ] && pids="$pids $p"
  fi
  extra="$(ps w 2>/dev/null | awk '
    (/[r]un\.mjs/ || /[s]erver\.mjs/) && /alfa/ { print $1 }
  ')"
  for p in $extra; do
    case " $pids " in
      *" $p "*) ;;
      *) pids="$pids $p" ;;
    esac
  done
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    cwd="$(readlink "$d/cwd" 2>/dev/null || true)"
    case "$cwd" in
      "$ADDON_DIR"|"$ADDON_DIR"/*)
        cmd="$(tr '\0' ' ' <"$d/cmdline" 2>/dev/null || true)"
        case "$cmd" in
          *run.mjs*|*server.mjs*)
            case " $pids " in
              *" $pid "*) ;;
              *) pids="$pids $pid" ;;
            esac
            ;;
        esac
        ;;
    esac
  done
  echo "$pids" | tr -s ' ' '\n' | sed '/^$/d' | sort -u
}

# Merlin: открыть :8788 на INPUT (иначе с телефона в LAN localhost-check проходит, а 192.168.x.x — нет)
ensure_firewall() {
  if command -v iptables >/dev/null 2>&1; then
    if ! iptables -C INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null; then
      iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || true
    fi
  fi
  if command -v ip6tables >/dev/null 2>&1; then
    if ! ip6tables -C INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null; then
      ip6tables -I INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || true
    fi
  fi
  # переживает пересборку firewall Merlin
  if [ -d /jffs/scripts ]; then
    touch /jffs/scripts/firewall-start 2>/dev/null || true
    chmod +x /jffs/scripts/firewall-start 2>/dev/null || true
    if [ -f /jffs/scripts/firewall-start ] && ! grep -q "dport ${PORT}.*#alfa" /jffs/scripts/firewall-start 2>/dev/null; then
      printf '%s\n' "iptables -I INPUT -p tcp --dport ${PORT} -j ACCEPT 2>/dev/null #alfa" >>/jffs/scripts/firewall-start
      printf '%s\n' "ip6tables -I INPUT -p tcp --dport ${PORT} -j ACCEPT 2>/dev/null #alfa" >>/jffs/scripts/firewall-start
    fi
  fi
}

port_pids() {
  if command -v fuser >/dev/null 2>&1; then
    fuser "${PORT}/tcp" 2>/dev/null | tr -s ' ' '\n' | sed '/^$/d'
  fi
}

stop_pids() {
  for attempt in 1 2 3; do
    pids="$(panel_pids)"
    [ -z "$pids" ] && break
    for pid in $pids; do
      if [ "$attempt" -lt 3 ]; then
        kill "$pid" 2>/dev/null || true
      else
        kill -9 "$pid" 2>/dev/null || true
      fi
    done
    sleep 1
  done
  rm -f "$PID_FILE" /var/run/alfa.pid
  # порт только если всё ещё занят чужим слушателем
  left="$(port_pids)"
  if [ -n "$left" ] && command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" 2>/dev/null || true
  fi
}

wait_stopped() {
  i=0
  while [ "$i" -lt 15 ]; do
    left="$(panel_pids)"
    if [ -z "$left" ] && ! is_running; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  stop_pids
  left="$(panel_pids)"
  [ -z "$left" ] || die "не удалось остановить панель (pids: $left)"
}

has_curl() {
  command -v curl >/dev/null 2>&1 || [ -x /opt/bin/curl ]
}

http_code() {
  if has_curl; then
    CURL_BIN="$(command -v curl 2>/dev/null || echo /opt/bin/curl)"
    "$CURL_BIN" -fsS -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/" 2>/dev/null || echo 000
  else
    echo none
  fi
}

wait_healthy() {
  i=0
  while [ "$i" -lt 25 ]; do
    if is_running; then
      code="$(http_code)"
      if [ "$code" = "200" ]; then
        echo "alfa healthy on :$PORT"
        return 0
      fi
      # curl нет — достаточно живого pid после паузы
      if [ "$code" = "none" ] && [ "$i" -ge 2 ]; then
        echo "alfa running pid $(cat "$PID_FILE") (curl нет — HTTP не проверен)"
        return 0
      fi
    fi
    i=$((i + 1))
    sleep 1
  done
  echo "alfa: панель не ответила на :$PORT — смотрите $LOG_FILE" >&2
  tail -n 40 "$LOG_FILE" 2>/dev/null || true
  return 1
}

# Отвязка от SSH / curl|sh: иначе SIGHUP убивает node, когда установщик завершается.
# trap '' HUP + run.mjs (глушит SIGHUP до загрузки панели).
daemonize_node() {
  NODE_BIN="$1"
  entry="run.mjs"
  [ -f "$ADDON_DIR/run.mjs" ] || entry="server.mjs"
  (
    trap '' HUP
    cd "$ADDON_DIR" || exit 1
    export ALFA_PID_FILE="$PID_FILE"
    exec env ALFA_PID_FILE="$PID_FILE" "$NODE_BIN" "$entry"
  ) >>"$LOG_FILE" 2>&1 </dev/null &
  echo $!
}

start() {
  ensure_firewall
  if is_running; then
    code="$(http_code)"
    if [ "$code" = "200" ] || [ "$code" = "none" ]; then
      echo "alfa already running pid $(cat "$PID_FILE")"
      return 0
    fi
    echo "alfa: pid жив, но HTTP $code — перезапуск"
    stop_pids
    wait_stopped
  fi
  left="$(panel_pids)"
  if [ -n "$left" ]; then
    stop_pids
    wait_stopped
  fi
  [ -f "$ADDON_DIR/server.mjs" ] || die "нет $ADDON_DIR/server.mjs — сначала установите аддон"
  NODE_BIN="$(resolve_node)" || die "нужен /opt/bin/node из Entware (opkg install node)"
  mkdir -p "$ADDON_DIR/data"
  : >>"$LOG_FILE"
  # предварительный pid — run.mjs перезапишет своим
  : >"$PID_FILE"
  pid="$(daemonize_node "$NODE_BIN")"
  [ -n "$pid" ] || die "не удалось запустить node"
  echo "$pid" >"$PID_FILE"
  ( echo "$pid" >/var/run/alfa.pid ) 2>/dev/null || true
  echo "alfa started on :$PORT (pid $pid, node $NODE_BIN)"
  echo "log: $LOG_FILE"
  sleep 1
  # если run.mjs уже записал другой pid — читаем актуальный
  if [ -f "$PID_FILE" ]; then
    newpid="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$newpid" ] && pid="$newpid"
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "alfa: процесс $pid сразу завершился" >&2
    tail -n 50 "$LOG_FILE" 2>/dev/null || true
    return 1
  fi
  wait_healthy || return 1
  sleep 1
  if ! kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    echo "alfa: процесс умер сразу после health-check" >&2
    tail -n 50 "$LOG_FILE" 2>/dev/null || true
    return 1
  fi
  return 0
}

stop() {
  stop_pids
  wait_stopped
  echo "alfa stopped"
}

status() {
  if is_running; then
    code="$(http_code)"
    echo "running pid $(cat "$PID_FILE") port $PORT http=$code"
    # без curl не считаем панель «упавшей»
    if [ "$code" = "200" ] || [ "$code" = "none" ]; then
      return 0
    fi
    return 1
  else
    echo "stopped"
    if [ -f "$LOG_FILE" ]; then
      echo "log tail:"
      tail -n 15 "$LOG_FILE" 2>/dev/null || true
    fi
    return 1
  fi
}

restart() {
  stop_pids
  wait_stopped
  start
}

uninstall() {
  stop_pids
  wait_stopped
  if [ -f /jffs/scripts/post-mount ]; then
    sed -i '/#alfa$/d' /jffs/scripts/post-mount 2>/dev/null || true
    sed -i '/\/jffs\/scripts\/alfa /d' /jffs/scripts/post-mount 2>/dev/null || true
  fi
  if [ -f /jffs/scripts/firewall-start ]; then
    sed -i '/#alfa$/d' /jffs/scripts/firewall-start 2>/dev/null || true
  fi
  rm -f /jffs/scripts/alfa "$PID_FILE" /var/run/alfa.pid "$LOG_FILE"
  rm -rf "$ADDON_DIR"
  echo "alfa removed from $ADDON_DIR"
  echo "SurfGate (/jffs/addons/ssurf) and official StealthSurf (/jffs/addons/stealthsurf) were not touched"
}

reset_password() {
  NODE_BIN="$(resolve_node)" || die "нужен /opt/bin/node"
  [ -f "$ADDON_DIR/scripts/reset-password.mjs" ] || die "нет scripts/reset-password.mjs"
  pass="${2:-alfa}"
  echo "alfa: останавливаю панель перед сбросом…"
  stop_pids
  wait_stopped
  # не держим cwd внутри ADDON_DIR дольше нужного
  "$NODE_BIN" "$ADDON_DIR/scripts/reset-password.mjs" "$pass" || die "сброс пароля не удался"
  start || die "панель не поднялась — смотрите $LOG_FILE"
  echo "панель: http://127.0.0.1:${PORT}/ (без пароля)"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) restart ;;
  status) status ;;
  uninstall|remove|un) uninstall ;;
  reset-password|passwd)
    reset_password "$@"
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status|uninstall|reset-password}"
    exit 1
    ;;
esac
