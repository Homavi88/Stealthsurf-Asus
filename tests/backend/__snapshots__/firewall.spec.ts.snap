exports[`firewall.sh generated rules boot in redirect mode restores learned addresses minus the time spent down 1`] = `
"== iptables -t filter
-N STEALTHSURF
-A INPUT -j STEALTHSURF
-A FORWARD -j STEALTHSURF
-A STEALTHSURF -m mark --mark 0x20000/0x20000 -j ACCEPT
-A STEALTHSURF -j RETURN
== iptables -t nat
-N STEALTHSURF
== iptables -t mangle
-N STEALTHSURF
-N STEALTHSURF_DIVERT
-A PREROUTING -p tcp -m socket --transparent -j STEALTHSURF_DIVERT
-A PREROUTING -j STEALTHSURF
-A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
-A OUTPUT -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
-A STEALTHSURF -m addrtype --dst-type LOCAL -p udp --dport 12345 -j RETURN
-A STEALTHSURF -m addrtype --dst-type LOCAL -p tcp --dport 12345 -j RETURN
-A STEALTHSURF -m set ! --match-set STEALTHSURF_PROXY4 dst -m set ! --match-set STEALTHSURF_PROXY4_NET dst -j RETURN
-A STEALTHSURF -m set --match-set STEALTHSURF_BYPASS4 dst -j RETURN
-A STEALTHSURF -m set --match-set STEALTHSURF_BYPASS4_NET dst -j RETURN
-A STEALTHSURF -m addrtype --src-type LOCAL -j RETURN
-A STEALTHSURF -m addrtype --dst-type LOCAL -j RETURN
-A STEALTHSURF -p udp -m socket --transparent -j MARK --set-mark 0x20000/0x20000
-A STEALTHSURF -p tcp -m socket --transparent -j MARK --set-mark 0x20000/0x20000
-A STEALTHSURF -d 10.8.0.0/24 -j RETURN
-A STEALTHSURF -d 192.168.1.0/24 -j RETURN
-A STEALTHSURF -d 192.168.101.0/24 -j RETURN
-A STEALTHSURF -p udp -m multiport --dports 67,68,123,500,4500,4501,51820 -j RETURN
-A STEALTHSURF -d 224.0.0.0/4 -j RETURN
-A STEALTHSURF -d 239.0.0.0/8 -j RETURN
-A STEALTHSURF -m addrtype --dst-type BROADCAST -j RETURN
-A STEALTHSURF -m conntrack --ctstate DNAT -j RETURN
-A STEALTHSURF -d 203.0.113.10 -j RETURN
-A STEALTHSURF -d 192.0.2.3 -j RETURN
-A STEALTHSURF -s 10.8.0.0/24 -p tcp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF -s 192.168.1.0/24 -p tcp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF -s 192.168.101.0/24 -p tcp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF -s 10.8.0.0/24 -p udp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF -s 192.168.1.0/24 -p udp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF -s 192.168.101.0/24 -p udp -j TPROXY --on-port 12345 --tproxy-mark 0x20000/0x20000
-A STEALTHSURF_DIVERT -j MARK --set-mark 0x20000/0x20000
-A STEALTHSURF_DIVERT -j CONNMARK --save-mark --mask 0x20000
-A STEALTHSURF_DIVERT -j ACCEPT
== ip -4 rule
fwmark 0x20000/0x20000 lookup 78
== ip -4 route table 78
local default dev lo proto static
192.0.2.0/24 dev eth0 proto kernel scope link src 192.0.2.3
10.8.0.0/24 dev tun21 proto kernel scope link src 10.8.0.1
127.0.0.0/8 dev lo scope link
192.168.1.0/24 dev br0 proto kernel scope link src 192.168.1.1
192.168.101.0/24 dev br1 proto kernel scope link src 192.168.101.1
== ipset
STEALTHSURF_BYPASS4 hash:net inet timeout 86400
STEALTHSURF_BYPASS4_NET hash:net inet
STEALTHSURF_PROXY4 hash:net inet timeout 86400
STEALTHSURF_PROXY4_NET hash:net inet
== ipset entries
STEALTHSURF_PROXY4 198.51.100.20 timeout 2000
== learned file
# 999000
STEALTHSURF_PROXY4 198.51.100.20 3000
STEALTHSURF_PROXY4 198.51.100.21 500
STEALTHSURF_PROXY6 2001:db8::1 3000
== events
dnsmasq_restart
== stderr
"
`;

