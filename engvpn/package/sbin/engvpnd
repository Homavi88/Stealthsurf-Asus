#!/bin/sh
# EngVPN Merlin daemon CLI — open reimplementation.
# Surface closer to stealthsurf-routerd: serve | set-password | status | stop |
# update-check | update | uninstall | reinstall | schedule-update | transparent |
# dpi | warp | cleanup | reconnect | watchdog + short aliases (up, remove, …)
set -u

# Resolve real binary path even when invoked as /opt/bin/engvpnd (symlink) or bare "engvpnd" from PATH.
# Package layout is always $PREFIX/sbin/engvpnd → ../share/engvpn (never $PREFIX/bin).
argv0=$0
case "$argv0" in
*/*) ;;
*)
	found=$(command -v -- "$argv0" 2>/dev/null) || found=
	[ -n "$found" ] && argv0=$found
	;;
esac
if [ -L "$argv0" ]; then
	resolved=$(readlink -f "$argv0" 2>/dev/null || true)
	if [ -z "$resolved" ]; then
		# BusyBox without -f: one-level absolute or relative link
		link=$(readlink "$argv0" 2>/dev/null || true)
		case "$link" in
		/*) resolved=$link ;;
		?*) resolved="${argv0%/*}/$link" ;;
		esac
	fi
	[ -n "${resolved:-}" ] && argv0=$resolved
fi
SHARE=$(cd "${argv0%/*}/../share/engvpn" 2>/dev/null && pwd -P) || {
	echo "engvpnd: cannot resolve share/engvpn" >&2
	exit 1
}
PREFIX=${SHARE%/share/engvpn}
RUNTIME=$SHARE/runtime
DATA_DIR=${ENGVPN_DATA_DIR:-$PREFIX/data}
PORT=${ENGVPN_PORT:-8790}
# Same per-prefix volatile dir as service.sh (never the global /tmp/engvpn-panel.pid —
# a stale global pidfile made watchdog think the panel was down and re-spawn service.sh).
PREFIX_HASH=$(printf '%s' "$PREFIX" | md5sum 2>/dev/null | awk '{print substr($1,1,12)}')
[ -n "$PREFIX_HASH" ] || PREFIX_HASH=default
VOLATILE_DIR=/tmp/engvpn-$PREFIX_HASH
PIDFILE=${ENGVPN_PIDFILE:-$VOLATILE_DIR/panel.pid}
LOGFILE=${ENGVPN_LOGFILE:-$VOLATILE_DIR/engvpnd.log}
VERSION_FILE=$SHARE/VERSION
INSTALL=$SHARE/install.sh

export PATH="/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export ENGVPN_PORT="$PORT"
# Persist open LAN access across restarts when install skipped the password.
if [ -z "${ENGVPN_OPEN_PANEL:-}" ] && [ -f "$DATA_DIR/open-panel" ]; then
	ENGVPN_OPEN_PANEL=1
fi
export ENGVPN_OPEN_PANEL="${ENGVPN_OPEN_PANEL:-0}"
export ENGVPN_PID_FILE="$PIDFILE"
export ENGVPN_DATA_DIR="$DATA_DIR"

usage() {
	cat <<EOF
Usage: engvpnd <command> [options]

  serve [--data-dir DIR]       Start the EngVPN panel (foreground)
  start                        Start panel via service.sh (supervisor + node)
  set-password [--data-dir DIR]
                               Read panel password from stdin; store pbkdf2 hash
  status | st                  Print running / stopped and port
  stop                         Stop the panel process
  restart                      Restart panel via service.sh
  update-check | check         Compare installed version to feed
  update | up                  Download feed package and upgrade in place
  uninstall | remove | удалить
                               Real uninstall (install.sh); ENGVPN_RESTORE=0/n skips farewell backup.
                               After remove, asks whether to delete sibling .engvpn-backup
                               (default keep). ENGVPN_DELETE_BACKUP=1 deletes; =0 keeps.
  reinstall | переустановить [--wipe]
                               Re-fetch from feed into same prefix (keeps data).
                               --wipe: wipe data then reinstall (needs confirm /
                               ENGVPN_REINSTALL_WIPE=1)
  schedule-update <run|install-cru|remove-cru|status|write-conf…>
                               Periodic feed check (+ optional auto-apply); Merlin cru
  transparent <start|stop|status|apply|dry-run>
                               Open iptables REDIRECT/TPROXY selective VPN
  dpi <start|stop|status|install|dry-run>
                               Open zapret/nfqws DPI (NFQUEUE packet mangling)
  privacy | priv [all|exit|dns|ipv6|killswitch|dpi|path|dry-run]
                               Privacy / stealth probes (exit IP, DNS, IPv6, kill-switch, DPI)
  warp <create|status|import-file|gre-up|gre-down|dry-run>
                               Cloudflare WARP (open API) + optional GRE tunnel
  backup <create|restore|latest|list>
                               Snapshot / restore prefix data + package files
  smartdns <status|apply|stop|dry-run>
                               Domain/IP bypass list → routing + iptables RETURN
  discover                     LAN devices from ARP/neigh/dnsmasq (JSONL)
  reconnect | fix              Re-apply transparent rules + restart panel service
  cleanup | clean              Tear down transparent/dpi/smartdns rules and temp files
  watchdog                     One-shot health: panel port + optional transparent restore
  version | ver                Print package version

Быстрые команды: start | up | check | remove | reinstall | st | restart | clean | priv | fix | ver
EOF
}

resolve_node() {
	if [ -n "${ENGVPN_NODE:-}" ] && [ -x "$ENGVPN_NODE" ]; then
		echo "$ENGVPN_NODE"
		return 0
	fi
	if [ -f "$PREFIX/.node-bin" ]; then
		saved=$(cat "$PREFIX/.node-bin" 2>/dev/null)
		[ -x "$saved" ] && echo "$saved" && return 0
	fi
	for c in /opt/bin/node /opt/bin/nodejs \
		"$(command -v node 2>/dev/null)" \
		/usr/bin/node /usr/local/bin/node; do
		[ -n "$c" ] && [ -x "$c" ] && echo "$c" && return 0
	done
	return 1
}

remember_node() {
	node=$1
	[ -n "$node" ] || return 0
	printf '%s\n' "$node" >"$PREFIX/.node-bin" 2>/dev/null || true
}

ensure_data() {
	mkdir -p "$DATA_DIR" || return 1
	chmod 700 "$DATA_DIR" 2>/dev/null || true
	if [ ! -e "$RUNTIME/data" ]; then
		ln -sfn "$DATA_DIR" "$RUNTIME/data" 2>/dev/null || mkdir -p "$RUNTIME/data"
	fi
}

alive_pid() {
	[ -n "$1" ] && [ -d "/proc/$1" ]
}

cmd_set_password() {
	ensure_data || {
		echo "engvpnd: cannot create $DATA_DIR" >&2
		exit 1
	}
	node=$(resolve_node) || {
		echo "engvpnd: Node.js required for set-password (Entware: opkg install node)" >&2
		exit 1
	}
	remember_node "$node"
	"$node" "$SHARE/set-password.mjs" --data-dir "$DATA_DIR" || exit $?
	# Password replaces open LAN access from a skip-password install.
	rm -f "$DATA_DIR/open-panel" 2>/dev/null || true
}

cmd_serve() {
	ensure_data || exit 1
	node=$(resolve_node) || {
		echo "engvpnd: Node.js required (Entware: opkg install node)" >&2
		exit 1
	}
	remember_node "$node"
	[ -f "$RUNTIME/run.mjs" ] || {
		echo "engvpnd: missing runtime at $RUNTIME" >&2
		exit 1
	}
	trap '' HUP
	cd "$RUNTIME" || exit 1
	if [ ! -d "$RUNTIME/data" ]; then
		ln -sfn "$DATA_DIR" "$RUNTIME/data" 2>/dev/null || true
	fi
	# Exclusive panel lock. Prefer flock (held across exec into Node). Also create
	# PANEL_LOCK.d so kill-strays can see a live panel even if Node closes fd 9.
	PANEL_LOCK=$DATA_DIR/.panel.lock
	: >>"$PANEL_LOCK" 2>/dev/null || true
	if type flock >/dev/null 2>&1; then
		exec 9>>"$PANEL_LOCK" || exit 1
		if ! flock -n 9; then
			echo "engvpnd: panel already running (lock $PANEL_LOCK)" >&2
			exit 75
		fi
	elif ! mkdir "$PANEL_LOCK.d" 2>/dev/null; then
		echo "engvpnd: panel already running (lockdir $PANEL_LOCK.d)" >&2
		exit 75
	else
		echo $$ >"$PANEL_LOCK.d/pid" 2>/dev/null || true
	fi
	# Durable marker (flock may be dropped if Node closes inherited fds)
	rm -rf "$PANEL_LOCK.d" 2>/dev/null || true
	mkdir -p "$PANEL_LOCK.d" 2>/dev/null || true
	printf '%s\n' "$$" >"$PANEL_LOCK.d/pid" 2>/dev/null || true
	# Record panel pid into transparent state for rule replay ownership
	export ENGVPN_TRANSPARENT_PID=$$
	export ENGVPN_PANEL_LOCK="$PANEL_LOCK"
	printf '%s\n' "$$" >"$PIDFILE" 2>/dev/null || true
	# exec: same PID becomes node — supervisor child tracking stays correct
	exec "$node" "$RUNTIME/run.mjs"
}

cmd_status() {
	pid=""
	[ -f "$PIDFILE" ] && read -r pid <"$PIDFILE" 2>/dev/null
	panel=stopped
	if alive_pid "$pid"; then
		panel="running pid=$pid"
	else
		extra=$(ps w 2>/dev/null | awk -v rt="$RUNTIME" '/[r]un\.mjs/ && index($0, rt) { print $1; exit }')
		[ -n "$extra" ] && panel="running pid=$extra"
	fi
	tp=inactive
	[ -x "$SHARE/transparent.sh" ] && tp=$(sh "$SHARE/transparent.sh" status 2>/dev/null | head -n 1)
	echo "panel=$panel port=$PORT prefix=$PREFIX"
	echo "transparent=$tp"
	[ "$panel" != stopped ] && return 0
	return 1
}

cmd_stop() {
	pid=""
	[ -f "$PIDFILE" ] && read -r pid <"$PIDFILE" 2>/dev/null
	if alive_pid "$pid"; then
		kill "$pid" 2>/dev/null || true
		i=0
		while [ "$i" -lt 20 ] && alive_pid "$pid"; do
			sleep 1
			i=$((i + 1))
		done
		alive_pid "$pid" && kill -9 "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
	echo "stopped"
}

cmd_update_check() {
	if [ -x "$SHARE/update.sh" ]; then
		export ENGVPN_FEED="${ENGVPN_FEED:-https://raw.githubusercontent.com/Homavi88/Stealthsurf-Asus/main/engvpn/feed/latest.json}"
		sh "$SHARE/update.sh" check
		return $?
	fi
	ver=unknown
	[ -f "$VERSION_FILE" ] && ver=$(cat "$VERSION_FILE")
	echo "installed=$ver"
	echo "feed=${ENGVPN_FEED:-https://raw.githubusercontent.com/Homavi88/Stealthsurf-Asus/main/engvpn/feed/latest.json}"
}

cmd_update() {
	[ -x "$SHARE/update.sh" ] || {
		echo "engvpnd: missing update.sh" >&2
		exit 1
	}
	export ENGVPN_FEED="${ENGVPN_FEED:-https://raw.githubusercontent.com/Homavi88/Stealthsurf-Asus/main/engvpn/feed/latest.json}"
	# Storm survivors block flock / starve CPU — clear before fetch+upgrade.
	if [ -x "$SHARE/service.sh" ]; then
		echo "engvpnd: kill-strays before update"
		sh "$SHARE/service.sh" kill-strays 2>/dev/null ||
			sh "$SHARE/service.sh" stop 2>/dev/null || true
	fi
	if command -v pkill >/dev/null 2>&1; then
		pkill -9 -f "$PREFIX/share/engvpn/runtime/run.mjs" 2>/dev/null || true
		pkill -9 -f "$PREFIX/sbin/engvpnd serve" 2>/dev/null || true
		pkill -9 -f "$PREFIX/share/engvpn/service.sh" 2>/dev/null || true
	fi
	export ENGVPN_STORM_CLEARED=1
	sh "$SHARE/update.sh" apply "$@"
}

cmd_uninstall() {
	[ -x "$INSTALL" ] || {
		echo "engvpnd: missing install.sh" >&2
		exit 1
	}
	# Real uninstall — same path as install.sh uninstall (ENGVPN_RESTORE prompt/env).
	# After clean remove, install.sh asks about deleting sibling .engvpn-backup
	# (default keep). Override: ENGVPN_DELETE_BACKUP=1|0.
	# Optional prefix override: engvpnd uninstall [<prefix>]
	if [ $# -ge 1 ]; then
		sh "$INSTALL" uninstall "$1"
	else
		sh "$INSTALL" uninstall "$PREFIX"
	fi
}

ask_reinstall_wipe() {
	case "${ENGVPN_REINSTALL_WIPE:-}" in
	1 | yes | YES | y | Y) return 0 ;;
	0 | no | NO | n | N) return 1 ;;
	esac
	if [ "${ENGVPN_SMOKE:-}" = 1 ]; then
		return 1
	fi
	{ : </dev/tty; } 2>/dev/null || {
		echo "engvpnd: wipe reinstall needs TTY or ENGVPN_REINSTALL_WIPE=1" >&2
		return 1
	}
	printf "Стереть data/ (пароль, аккаунт, настройки) и переустановить пакет? [y/N]: " >/dev/tty
	ans=""
	IFS= read -r ans </dev/tty || ans=""
	case "$ans" in
	y | Y | yes | YES | да | Да | ДА) return 0 ;;
	esac
	return 1
}

cmd_reinstall() {
	wipe=0
	wait=60
	while [ $# -gt 0 ]; do
		case "$1" in
		--wipe | wipe)
			wipe=1
			shift
			;;
		[0-9]*)
			wait=$1
			shift
			;;
		*)
			echo "engvpnd: reinstall: unknown option: $1 (use --wipe)" >&2
			exit 2
			;;
		esac
	done
	[ -x "$SHARE/update.sh" ] || {
		echo "engvpnd: missing update.sh" >&2
		exit 1
	}
	export ENGVPN_FEED="${ENGVPN_FEED:-https://raw.githubusercontent.com/Homavi88/Stealthsurf-Asus/main/engvpn/feed/latest.json}"
	if [ "$wipe" = 1 ]; then
		ask_reinstall_wipe || {
			echo "engvpnd: wipe reinstall cancelled (set ENGVPN_REINSTALL_WIPE=1 to confirm)" >&2
			exit 1
		}
		echo "reinstall: wiping data at $DATA_DIR (package files re-fetched from feed)"
		if [ -x "$SHARE/service.sh" ]; then
			sh "$SHARE/service.sh" stop 2>/dev/null || true
		else
			cmd_stop >/dev/null 2>&1 || true
		fi
		# Drop user state (password, account, …); package re-fetched from feed below.
		rm -rf "$DATA_DIR"
		mkdir -p "$DATA_DIR"
		chmod 700 "$DATA_DIR" 2>/dev/null || true
	else
		echo "reinstall: keeping data/; force-refresh package from feed"
		if [ -x "$SHARE/service.sh" ]; then
			sh "$SHARE/service.sh" stop 2>/dev/null || true
		else
			cmd_stop >/dev/null 2>&1 || true
		fi
	fi
	export ENGVPN_FORCE_UPDATE=1
	sh "$SHARE/update.sh" apply "$wait"
}

cmd_start() {
	# Users naturally run `engvpnd start` after a dead panel. Pre-0.5.32 this was
	# an unknown command (exit 2) — panel never came back. Prefer service.sh so
	# one supervisor + run.mjs is restored (same path as Merlin hooks).
	echo "engvpnd: start → $SHARE/service.sh (prefix=$PREFIX port=$PORT)"
	if [ -x "$SHARE/service.sh" ]; then
		sh "$SHARE/service.sh" start
		_rc=$?
		if [ "$_rc" -ne 0 ]; then
			echo "engvpnd: start failed (rc=$_rc). Try: $SHARE/service.sh start" >&2
			echo "engvpnd: or: engvpnd restart | engvpnd watchdog" >&2
			echo "engvpnd: log: $LOGFILE  last-event: $DATA_DIR/last-event" >&2
		fi
		return $_rc
	fi
	echo "engvpnd: missing $SHARE/service.sh" >&2
	if cmd_status >/dev/null 2>&1; then
		echo "EngVPN already running (port $PORT)"
		return 0
	fi
	mkdir -p "$VOLATILE_DIR" 2>/dev/null || true
	cmd_serve >>"$LOGFILE" 2>&1 &
	echo "EngVPN started (port $PORT) [no service.sh — background serve]"
}

cmd_restart() {
	if [ -x "$SHARE/service.sh" ]; then
		sh "$SHARE/service.sh" restart
		return $?
	fi
	cmd_stop
	# Background start without exec — service.sh preferred on Merlin
	cmd_serve >/dev/null 2>&1 &
	echo "restarted"
}

cmd_schedule_update() {
	[ -x "$SHARE/schedule-update.sh" ] || {
		echo "engvpnd: missing schedule-update.sh" >&2
		exit 1
	}
	ensure_data
	export ENGVPN_FEED="${ENGVPN_FEED:-https://raw.githubusercontent.com/Homavi88/Stealthsurf-Asus/main/engvpn/feed/latest.json}"
	sh "$SHARE/schedule-update.sh" "$@"
}

cmd_transparent() {
	[ -x "$SHARE/transparent.sh" ] || {
		echo "engvpnd: missing transparent.sh" >&2
		exit 1
	}
	ensure_data
	export ENGVPN_TRANSPARENT_PID
	ENGVPN_TRANSPARENT_PID=$(cat "$PIDFILE" 2>/dev/null || echo $$)
	sh "$SHARE/transparent.sh" "$@"
}

cmd_dpi() {
	[ -x "$SHARE/dpi.sh" ] || {
		echo "engvpnd: missing dpi.sh" >&2
		exit 1
	}
	ensure_data
	sh "$SHARE/dpi.sh" "$@"
}

cmd_privacy() {
	[ -x "$SHARE/privacy-check.sh" ] || {
		echo "engvpnd: missing privacy-check.sh" >&2
		exit 1
	}
	ensure_data
	sh "$SHARE/privacy-check.sh" "$@"
}

cmd_warp() {
	[ -x "$SHARE/warp.sh" ] || {
		echo "engvpnd: missing warp.sh" >&2
		exit 1
	}
	ensure_data
	sh "$SHARE/warp.sh" "$@"
}

cmd_backup() {
	[ -x "$SHARE/backup.sh" ] || {
		echo "engvpnd: missing backup.sh" >&2
		exit 1
	}
	sh "$SHARE/backup.sh" "$@"
}

cmd_smartdns() {
	[ -x "$SHARE/smartdns.sh" ] || {
		echo "engvpnd: missing smartdns.sh" >&2
		exit 1
	}
	ensure_data
	sh "$SHARE/smartdns.sh" "$@"
}

cmd_discover() {
	[ -x "$SHARE/discover-devices.sh" ] || {
		echo "engvpnd: missing discover-devices.sh" >&2
		exit 1
	}
	ensure_data
	sh "$SHARE/discover-devices.sh" "$@"
}

cmd_reconnect() {
	ensure_data
	# Re-apply transparent rules if configured
	if [ -f "$DATA_DIR/transparent.conf" ]; then
		mode=$(awk -F= '$1=="mode"{print $2}' "$DATA_DIR/transparent.conf" 2>/dev/null)
		[ "$mode" != off ] && [ -n "$mode" ] && sh "$SHARE/transparent.sh" apply || true
	fi
	if [ -f "$DATA_DIR/dpi.conf" ]; then
		en=$(awk -F= '$1=="enabled"{print $2}' "$DATA_DIR/dpi.conf" 2>/dev/null)
		[ "$en" = 1 ] && sh "$SHARE/dpi.sh" apply 2>/dev/null || true
	fi
	if [ -f "$DATA_DIR/smartdns.conf" ]; then
		en=$(awk -F= '$1=="enabled"{print $2}' "$DATA_DIR/smartdns.conf" 2>/dev/null)
		[ "$en" = 1 ] && sh "$SHARE/smartdns.sh" apply 2>/dev/null || true
	fi
	if [ -x "$SHARE/service.sh" ]; then
		sh "$SHARE/service.sh" restart
	else
		cmd_stop
		cmd_serve &
	fi
	echo "reconnect: done"
}

cmd_cleanup() {
	[ -x "$SHARE/transparent.sh" ] && sh "$SHARE/transparent.sh" stop || true
	[ -x "$SHARE/dpi.sh" ] && sh "$SHARE/dpi.sh" stop || true
	[ -x "$SHARE/smartdns.sh" ] && sh "$SHARE/smartdns.sh" stop || true
	[ -x "$SHARE/warp.sh" ] && sh "$SHARE/warp.sh" gre-down || true
	rm -rf /tmp/engvpn /tmp/engvpn-package /tmp/engvpn-update.* /tmp/engvpn-zapret.* /tmp/engvpn-nfqws.* 2>/dev/null || true
	echo "cleanup: done"
}

cmd_watchdog() {
	# Panel listen check
	ok=1
	if ! cmd_status >/dev/null 2>&1; then
		# Never nest service.sh start from inside the supervisor loop —
		# that spawned waiter storms ([SERVICE] sh) on Merlin.
		if [ "${ENGVPN_IN_SUPERVISOR:-}" = 1 ]; then
			echo "watchdog: panel down (under supervisor — not nesting start)"
			ok=0
		else
			echo "watchdog: panel down — restarting"
			[ -x "$SHARE/service.sh" ] && sh "$SHARE/service.sh" start || true
			ok=0
		fi
	fi
	# Transparent restore if state says active but chains missing
	if [ -f "$DATA_DIR/netfilter/rules" ] && [ -x "$SHARE/netfilter.sh" ]; then
		if ! iptables -w -t nat -L ENGVPN -n >/dev/null 2>&1 &&
			! iptables -w -t mangle -L ENGVPN -n >/dev/null 2>&1; then
			mode=$(awk -F= '$1=="mode"{print $2}' "$DATA_DIR/transparent.conf" 2>/dev/null || true)
			if [ -n "$mode" ] && [ "$mode" != off ]; then
				echo "watchdog: restoring transparent rules"
				sh "$SHARE/netfilter.sh" replay >/dev/null || true
				ok=0
			fi
		fi
	fi
	[ "$ok" = 1 ] && echo "watchdog: ok" || echo "watchdog: repaired"
}

# Parse optional --data-dir
while [ $# -gt 0 ]; do
	case "$1" in
	--data-dir)
		DATA_DIR=$2
		export ENGVPN_DATA_DIR="$DATA_DIR"
		shift 2
		;;
	--help | -h)
		usage
		exit 0
		;;
	*)
		break
		;;
	esac
done

ACTION=${1:-}
[ -n "$ACTION" ] && shift

case "$ACTION" in
serve) cmd_serve "$@" ;;
start) cmd_start ;;
set-password) cmd_set_password "$@" ;;
status | st) cmd_status ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
update-check | check) cmd_update_check ;;
update | up) cmd_update "$@" ;;
uninstall | remove | удалить) cmd_uninstall "$@" ;;
reinstall | переустановить) cmd_reinstall "$@" ;;
schedule-update) cmd_schedule_update "$@" ;;
transparent) cmd_transparent "$@" ;;
dpi) cmd_dpi "$@" ;;
privacy | priv) cmd_privacy "$@" ;;
warp) cmd_warp "$@" ;;
backup) cmd_backup "$@" ;;
smartdns) cmd_smartdns "$@" ;;
discover) cmd_discover "$@" ;;
reconnect | fix) cmd_reconnect ;;
cleanup | clean) cmd_cleanup ;;
watchdog) cmd_watchdog ;;
version | ver)
	[ -f "$VERSION_FILE" ] && cat "$VERSION_FILE" || echo "0.0.0"
	;;
"" | help | -h | --help | помощь) usage ;;
*)
	echo "engvpnd: unknown command: $ACTION" >&2
	usage >&2
	exit 2
	;;
esac
